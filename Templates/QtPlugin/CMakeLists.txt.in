# The Qt interface is optional. SDK-only builds skip this template target.
if(NOT VISIONFLOW_BUILD_STUDIO)
    return()
endif()
find_package(OpenCV CONFIG REQUIRED COMPONENTS core)
add_library(@NAME@ SHARED @NAME@.hpp @NAME@.cpp)
target_link_libraries(@NAME@ PRIVATE VisionFlow::QtNodeUi opencv_core)
set_target_properties(@NAME@ PROPERTIES PREFIX "" SUFFIX ".fp")
if(COMMAND visionflow_register_plugin)
    visionflow_register_plugin(@NAME@)
endif()
if(MSVC)
    target_compile_options(@NAME@ PRIVATE /utf-8)
endif()
install(TARGETS @NAME@ RUNTIME DESTINATION Plugins LIBRARY DESTINATION Plugins)
